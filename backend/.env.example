# Ollama
OLLAMA_HOST=http://localhost:11434

# Models
PRIMARY_MODEL=qwen2.5-coder:32b
FAST_MODEL=qwen2.5-coder:14b
EMBEDDING_MODEL=nomic-embed-text

# Context
PRIMARY_MODEL_CTX=32768
FAST_MODEL_CTX=16384

# Paths
QDRANT_PATH=./qdrant_data
SQLITE_PATH=./session_data.db
PROJECT_ROOT=./projects

# Performance
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_SIZE=200
FILE_CACHE_MAX_MB=100

# Limits
MAX_TOOL_CALLS_PER_SESSION=50
MAX_AUTONOMOUS_RUNTIME_SECONDS=600
MAX_ITERATIONS_PER_TASK=20
MAX_RETRIES_PER_TOOL=3

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Debug
DEBUG=false
